<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="CardPreview" style="width: 130px; height: 192px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-image: none; justify-content: flex-start; margin-right: 5px; margin-bottom: 5px;">
        <ui:VisualElement name="Illustration" style="flex-grow: 1; align-items: center; width: 130px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: 0; height: 192px; background-image: resource(&apos;GUI/CardPlaceholder&apos;); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(19, 6, 6, 0); -unity-slice-type: sliced; background-position-x: left 0; justify-content: flex-start; background-position-y: top 0; background-size: contain; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
        <ui:VisualElement name="Template" style="flex-grow: 1; background-image: resource(&apos;GUI/CardTemplate&apos;); width: 130px; height: 191px; max-width: 350px; max-height: 516px; position: absolute;">
            <ui:VisualElement name="CostCircle" style="flex-grow: 1; background-image: resource(&apos;GUI/CostCircle&apos;); -unity-background-image-tint-color: rgb(126, 0, 255); max-width: 22px; max-height: 50px; width: 22px; height: 50px; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; align-items: center; justify-content: center; align-self: auto;">
                <ui:Label text="0" name="Cost" style="color: rgb(255, 255, 255); font-size: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-Medium&apos;); text-overflow: clip; -unity-text-outline-width: 0.3px; -unity-text-outline-color: rgb(0, 0, 0); align-self: auto;" />
            </ui:VisualElement>
            <ui:VisualElement name="Informations" style="flex-grow: 1; justify-content: flex-end; height: 420px; max-height: 420px; align-items: center;">
                <ui:Label text="Lore Description" name="Lore" style="font-size: 4px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-bottom: 5px; padding-top: 5px; -unity-text-align: middle-center; padding-right: 5px; padding-left: 5px; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-Regular&apos;); color: rgb(255, 255, 255); height: 9px;" />
                <ui:Label text="Effect description" name="EffectDesc" style="margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; padding-left: 0; padding-top: 0; padding-right: -9px; padding-bottom: 0; -unity-text-align: middle-center; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-Regular&apos;); border-bottom-width: 0; font-size: 4px; justify-content: flex-start; border-top-width: 0; border-right-width: 0; border-left-width: 0; height: 13px; width: 106px;" />
                <ui:Label text="Dark Magician" name="Name" style="background-color: rgba(0, 0, 0, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; align-items: center; margin-right: 0; margin-left: 0; -unity-font-style: normal; margin-top: 0; margin-bottom: 0; -unity-text-align: upper-center; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-BoldItalic&apos;); font-size: 7px; color: rgb(255, 255, 255);" />
                <ui:VisualElement name="Points" style="flex-grow: 1; flex-direction: row; justify-content: center; height: auto; max-height: 13px; width: auto; max-width: none;">
                    <ui:Label text="5" name="ATK" style="-unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-Medium&apos;); color: rgb(255, 255, 255); font-size: 5px; width: 33px; -unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                    <ui:Label text="5" name="DEF" style="-unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-Medium&apos;); color: rgb(255, 255, 255); font-size: 5px; width: 33px; -unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
