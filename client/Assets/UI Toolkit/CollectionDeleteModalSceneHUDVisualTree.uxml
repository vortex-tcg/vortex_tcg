<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-image: resource(&apos;GUI/CollectionModalGUI&apos;); background-color: rgba(0, 0, 0, 0.69);">
        <ui:VisualElement style="flex-grow: 1; background-image: resource(&apos;GUI/HomeBottomBanner&apos;); background-position-x: left 0; background-position-y: top 0; -unity-background-scale-mode: stretch-to-fill; height: 53px; max-height: 53px;" />
        <ui:VisualElement name="Container" style="flex-grow: 1; flex-direction: column; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.46);">
            <ui:VisualElement name="Text" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; height: 100px; max-height: 100px; width: 333px; flex-wrap: wrap; margin-top: 20px;">
                <ui:Label text="Voulez-vous supprimer le deck" name="WantToDeleteDeckLabel" style="background-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-SemiBold&apos;); font-size: 22px;" />
                <ui:Label text="Deck" name="DeckName" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-BlackItalic&apos;);" />
                <ui:Label text="?" name="QuestionMarkLabel" style="color: rgb(255, 255, 255); font-size: 22px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-direction: row; max-height: 100px; max-width: none; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; justify-content: space-evenly; height: 100px; align-items: center;">
                <ui:Button text="Valider" name="ConfirmButton" class="button" style="width: 193px; -unity-text-align: middle-center; font-size: 25px; height: 52px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); color: rgb(255, 255, 255); -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-ExtraBold&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;GUI/MenuButton&apos;);" />
                <ui:Button text="Annuler" name="CancelButton" class="button" style="width: 193px; -unity-text-align: middle-center; font-size: 25px; height: 52px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); color: rgb(255, 255, 255); -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-ExtraBold&apos;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;GUI/MenuButton&apos;);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; max-height: 53px; height: 53px; background-image: resource(&apos;GUI/HomeBottomBanner&apos;);" />
    </ui:VisualElement>
</ui:UXML>
