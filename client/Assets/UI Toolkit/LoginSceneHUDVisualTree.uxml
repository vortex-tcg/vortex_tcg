<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MatchSceneHUDStylesheet.uss?fileID=7433441132597879392&amp;guid=2177595ec7397e54f8540429d6376417&amp;type=3#MatchSceneHUDStylesheet" />
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center; justify-content: flex-start; background-image: resource(&apos;GUI/Background&apos;);">
        <ui:VisualElement style="flex-grow: 1; align-items: center; height: 800px; max-height: 800px; justify-content: flex-end;">
            <ui:VisualElement name="LogoVortex" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Resources/Images/Logo/vortex-name-logo.png?fileID=2800000&amp;guid=40c71d2b62fdeed49a4acdc8e429fe34&amp;type=3#vortex-name-logo&quot;); -unity-slice-type: sliced; width: 700px; height: auto; max-height: 300px; background-repeat: no-repeat no-repeat; background-position-y: top 0; -unity-background-scale-mode: scale-to-fit; justify-content: flex-start;" />
            <ui:VisualElement name="LoginContainer" class="bordered" style="flex-grow: 1; height: 250px; width: 900px; max-height: 250px; max-width: 900px; align-items: center; justify-content: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; background-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgba(255, 255, 255, 0);">
                <ui:VisualElement name="UsernameInput" style="flex-grow: 1; height: 74px; max-height: 74px; width: 347px; align-items: center; justify-content: center;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: resource(&apos;GUI/AuthenticationInput&apos;); width: 619px; height: 74px; max-height: 74px; position: absolute; align-items: center; justify-content: center; flex-direction: column;" />
                    <ui:TextField placeholder-text="Username" name="UsernameField" style="width: 590px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-font-definition: url(&quot;project://database/Assets/Resources/Fonts/Rubik/Rubik-Italic-VariableFont_wght.ttf?fileID=12800000&amp;guid=adf257f3529dd784faa67150faa0df43&amp;type=3#Rubik-Italic-VariableFont_wght&quot;); background-image: resource(&apos;GUI/AuthenticationInput&apos;); -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-position-x: left 0; background-position-y: top 0; background-color: rgba(0, 0, 0, 0); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0);" />
                </ui:VisualElement>
                <ui:VisualElement name="PasswordInput" style="flex-grow: 1; -unity-text-align: upper-center; justify-content: center; align-items: center;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: resource(&apos;GUI/AuthenticationInput&apos;); width: 619px; height: 74px; max-height: 74px; position: absolute; align-items: center; justify-content: center; flex-direction: column;" />
                    <ui:TextField placeholder-text="Password" name="PasswordField" is-delayed="true" style="width: 590px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; -unity-font-definition: url(&quot;project://database/Assets/Resources/Fonts/Rubik/Rubik-Italic-VariableFont_wght.ttf?fileID=12800000&amp;guid=adf257f3529dd784faa67150faa0df43&amp;type=3#Rubik-Italic-VariableFont_wght&quot;);" />
                </ui:VisualElement>
                <ui:Button text="LOGIN" name="LoginButton" triple-click-selects-line="false" class="button" style="width: 347px; font-size: 35px; background-image: resource(&apos;GUI/AuthenticationButton&apos;); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 74px; max-height: 74px; background-color: rgba(255, 255, 255, 0); align-items: center; justify-content: center; align-self: auto; -unity-text-align: middle-center; -unity-font-definition: resource(&apos;Fonts/Rubik/static/Rubik-SemiBold&apos;); color: rgb(255, 255, 255);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Error" name="ErrorLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Resources/Fonts/Rubik/static/Rubik-Regular.ttf?fileID=12800000&amp;guid=184e8b0f4c9ba8e4586adc3dea683c32&amp;type=3#Rubik-Regular&quot;); color: rgb(188, 3, 3); display: none; margin-top: 20px; font-size: 25px;" />
    </ui:VisualElement>
</ui:UXML>
