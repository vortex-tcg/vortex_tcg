:root {
}

.unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    -unity-font-definition: resource('Fonts/Rubik/static/Rubik-Regular');
}

.vortexButton {
    background-image: resource('GUI/MenuButton');
    height: 50px;
    width: 277px;
    max-width: 277px;
    max-height: 50px;
    color: rgb(255, 255, 255);
    -unity-font-definition: resource('Fonts/Rubik/static/Rubik-Bold');
    -unity-font-style: normal;
    font-size: 16px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
